{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://heart-intelligence.earth/schemas/claim.schema.json",
  "title":"Prometheus Claim",
  "type":"object",
  "required":["claim_uid","lineage","statement","status","public_use","source_refs","permitted_wording","blocked_wording"],
  "additionalProperties":false,
  "properties":{
    "claim_uid":{"type":"string","pattern":"^prometheus\\.[a-z0-9_.-]+$"},
    "legacy_claim_id":{"type":["string","null"]},
    "lineage":{"type":"string","minLength":1},
    "statement":{"type":"string","minLength":1},
    "status":{"type":"string","enum":["architectural","methodological","hypothesis","external_evidence","pilot_observed","third_party_reviewed","legally_admitted","market_admitted","research_only","candidate_methodological_amendment","design_legal_gated","pre_instrument","pilot_required"]},
    "public_use":{"type":"string","enum":["yes","definition","qualified","limited","candidate_definition","research_only","disclosure_only","restricted","no_offer","yes_as_boundary"]},
    "source_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "permitted_wording":{"type":"string","minLength":1},
    "blocked_wording":{"type":"array","items":{"type":"string"}}
  }
}
