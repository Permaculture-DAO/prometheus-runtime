{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://heart-intelligence.earth/schemas/relationship.assertion.schema.json",
  "title":"Prometheus Relationship Assertion",
  "type":"object",
  "required":["relationship_uid","source_actor_or_method","subject_uid","predicate","object_uid_or_literal","valid_from","provenance_refs","uncertainty","epistemic_status","zero_weight_for_pru"],
  "additionalProperties":false,
  "properties":{
    "relationship_uid":{"type":"string","pattern":"^rel_[A-Za-z0-9_-]+$"},
    "source_actor_or_method":{"type":"string","minLength":1},
    "subject_uid":{"type":"string","minLength":1},
    "predicate":{"type":"string","minLength":1},
    "object_uid_or_literal":{"type":"string","minLength":1},
    "valid_from":{"type":"string","format":"date-time"},
    "valid_to":{"type":["string","null"],"format":"date-time"},
    "scope":{"type":["string","null"]},
    "provenance_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "uncertainty":{"type":"string","minLength":1},
    "epistemic_status":{"type":"string","enum":["context","hypothesis","observation","evidence"]},
    "zero_weight_for_pru":{"type":"boolean","const":true}
  }
}
