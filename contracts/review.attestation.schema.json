{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://heart-intelligence.earth/schemas/review.attestation.schema.json",
  "title":"Prometheus Review Attestation",
  "type":"object",
  "required":["review_uid","reviewer_uid","scope","coi_status","subject_refs","decision","limitations","reviewed_at","independent_for_scope"],
  "additionalProperties":false,
  "properties":{
    "review_uid":{"type":"string","pattern":"^rev_[A-Za-z0-9_-]+$"},
    "reviewer_uid":{"type":"string","minLength":1},
    "scope":{"type":"string","minLength":1},
    "coi_status":{"type":"string","enum":["independent","advisory_only","conflicted"]},
    "subject_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "decision":{"type":"string","enum":["pass","conditional","fail","not_reviewed"]},
    "limitations":{"type":"string","minLength":1},
    "reviewed_at":{"type":"string","format":"date-time"},
    "independent_for_scope":{"type":"boolean"}
  },
  "allOf":[
    {"if":{"properties":{"coi_status":{"const":"conflicted"}}},"then":{"properties":{"decision":{"not":{"const":"pass"}},"independent_for_scope":{"const":false}}}},
    {"if":{"properties":{"coi_status":{"const":"independent"}}},"then":{"properties":{"independent_for_scope":{"const":true}}}}
  ]
}
