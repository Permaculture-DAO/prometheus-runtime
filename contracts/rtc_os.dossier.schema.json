{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "NO_ACTION",
            "LEAN_INTERVENTION",
            "REGENERATIVE",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "constraints": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Constraints",
          "type": "array"
        },
        "maintenance_ref": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maintenance Ref"
        }
      },
      "required": [
        "option_id",
        "kind",
        "constraints",
        "maintenance_ref"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "BioregionalStrategyProfile": {
      "additionalProperties": false,
